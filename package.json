{
  "name": "bmc-actions",
  "version": "1.0.0",
  "private": true,
  "description": "bare-metal-cloud drop-in artifact actions: upload-artifact and download-artifact for BMC runners",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build:upload && npm run build:download",
    "build:upload": "ncc build upload-artifact/src/index.ts -o upload-artifact/dist",
    "build:download": "ncc build download-artifact/src/index.ts -o download-artifact/dist",
    "dist-freshness": "npm run build && git diff --exit-code -- upload-artifact/dist download-artifact/dist",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run dist-freshness"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0",
    "minimatch": "^9.0.5",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
